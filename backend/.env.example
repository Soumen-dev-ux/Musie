PORT=4000
HOST=0.0.0.0

# Optional server-level defaults (can also be supplied per-request from App Settings)
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional path to yt-dlp binary if not on system PATH
YT_DLP_PATH=yt-dlp

# AdGuard defaults
ADGUARD_ENABLED=true
SPONSORBLOCK_ENABLED=true
