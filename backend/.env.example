PORT=4000
HOST=0.0.0.0

# Optional server-level defaults (can also be supplied per-request from App Settings)
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional path to yt-dlp binary if not on system PATH
YT_DLP_PATH=yt-dlp

# Optional YouTube cookies (helps avoid 403/bot checks on cloud/Render IPs)
YT_COOKIES_CONTENT=
YT_COOKIES_FILE=/etc/secrets/cookies.txt
YT_PROXY_URL=
PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de,https://api.piped.private.coffee

# Optional persistent data directory (e.g., /var/data on Render Persistent Disk)
DATA_DIR=

# AdGuard defaults
ADGUARD_ENABLED=true
SPONSORBLOCK_ENABLED=true
